#: scripts/_lib/map_template.py:260
#, python-brace-format
msgid ""
"Sources : INAO ({inao}) pour les cahiers des charges et les aires "
"parcellaires françaises, IGN ({ign}) pour les contours des communes "
"françaises, le registre des indications géographiques de l'UE, les "
"régulateurs nationaux, Eurostat GISCO et Bétard 2022 pour les autres "
"pays, OpenStreetMap et CARTO pour le fond de carte, Wikipedia "
"({wikipedia}) pour quelques compléments narratifs (CC BY-SA 4.0), et VIVC"
" ({vivc}), le Vitis International Variety Catalogue du Julius Kühn-"
"Institut, pour les noms canoniques et numéros de cépage (citation Röckel "
"et al.). Tout extrait Wikipedia est signalé sur place. Détails et "
"licences dans le {readme}."
msgstr ""
"Sources : INAO ({inao}) pour les cahiers des charges et les aires "
"parcellaires françaises, IGN ({ign}) pour les contours des communes "
"françaises, le registre des indications géographiques de l'UE, les "
"régulateurs nationaux, Eurostat GISCO et Bétard 2022 pour les autres "
"pays, OpenStreetMap et CARTO pour le fond de carte, Wikipedia "
"({wikipedia}) pour quelques compléments narratifs (CC BY-SA 4.0), et VIVC"
" ({vivc}), le Vitis International Variety Catalogue du Julius Kühn-"
"Institut, pour les noms canoniques et numéros de cépage (citation Röckel "
"et al.). Tout extrait Wikipedia est signalé sur place. Détails et "
"licences dans le {readme}."

