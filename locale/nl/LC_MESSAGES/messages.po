msgid "Données mises à jour le {date}."
msgstr "Gegevens bijgewerkt op {date}."

#: scripts/_lib/map_template.py:580
#, python-brace-format
msgid ""
"Votre navigateur parle déjà {webmcp} ? Chaque page de la carte lui "
"propose les mêmes outils. Sinon, aucune importance : c'est le serveur MCP"
" ci-dessus que votre assistant IA sait utiliser."
msgstr ""
"Spreekt je browser al {webmcp}? Elke pagina van de kaart biedt hem "
"dezelfde zoekfuncties aan. Zegt dat je niets, geen probleem: de MCP-"
"server hierboven is degene die je AI-assistent kan gebruiken."

