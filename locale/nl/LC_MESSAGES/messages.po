#: scripts/_lib/map_template.py:618
msgid "Appellations cochées."
msgstr "Aangevinkte appellaties."

#: scripts/_lib/map_template.py:619
msgid "Ouvre ces appellations : fiche, surbrillance, cadrage."
msgstr "Opent deze appellaties: kaart, markering, inzoomen."

#: scripts/_lib/map_template.py:620
msgid "AOP masquées (affichées par défaut)."
msgstr "BOB verborgen (standaard getoond)."

#: scripts/_lib/map_template.py:621
msgid "IGP affichées (masquées par défaut)."
msgstr "BGA getoond (standaard verborgen)."

#: scripts/_lib/map_template.py:622
msgid "Spiritueux affichés (masqués par défaut)."
msgstr "Gedistilleerd getoond (standaard verborgen)."

#: scripts/_lib/map_template.py:623
msgid "Carte seule, à intégrer dans une page."
msgstr "Alleen de kaart, om in een pagina in te sluiten."

#: scripts/_lib/map_template.py:624
msgid "Thème sombre de la carte intégrée."
msgstr "Donker thema voor de ingesloten kaart."

#: scripts/_lib/map_template.py:625
msgid "Zone à cadrer : ouest,sud,est,nord en degrés."
msgstr "Gebied om in te kaderen: west,zuid,oost,noord in graden."

#: scripts/_lib/map_template.py:626
msgid "Zoom/latitude/longitude ; l'emporte sur bbox."
msgstr "Zoom/breedtegraad/lengtegraad; wint van bbox."

#: scripts/_lib/map_template.py:627
msgid "Copier l'adresse du serveur MCP"
msgstr "Het adres van de MCP-server kopiëren"

#: scripts/_lib/map_template.py:629
#, python-brace-format
msgid ""
"Les assistants IA peuvent interroger les appellations avec les mêmes "
"outils de recherche que la carte, via le serveur MCP {mcp_link} (sans "
"authentification ; à ajouter comme connecteur personnalisé)."
msgstr ""
"AI-assistenten kunnen de appellaties doorzoeken met dezelfde zoekfuncties"
" als de kaart, via de MCP-server {mcp_link} (zonder authenticatie; voeg "
"hem toe als eigen connector)."

