#: scripts/_lib/map_template.py:594
msgid "Intégrer sur votre site"
msgstr "Insluiten op je site"

#: scripts/_lib/map_template.py:596
msgid ""
"Collez ce code dans votre page : la carte reste interactive, et un clic "
"sur une appellation l'ouvre sur Open Wine Map."
msgstr ""
"Plak deze code in je pagina: de kaart blijft interactief, en een klik op "
"een appellatie opent die op Open Wine Map."

#: scripts/_lib/map_template.py:599
msgid "Copier le code d'intégration"
msgstr "Insluitcode kopiëren"

#: scripts/_lib/map_template.py:602
#, python-brace-format
msgid "{what} sur Open Wine Map"
msgstr "{what} op Open Wine Map"

#: scripts/_lib/map_template.py:604
msgid "Ouvrir sur Open Wine Map"
msgstr "Openen op Open Wine Map"

#: scripts/_lib/map_template.py:606
msgid "Thème de la carte intégrée"
msgstr "Thema van de ingesloten kaart"

#: scripts/_lib/map_template.py:608
msgid "Paramètres d'URL (utilisateurs avancés)"
msgstr "URL-parameters (gevorderde gebruikers)"

#: scripts/_lib/map_template.py:610
msgid ""
"Chaque paramètre peut s'écrire à la main dans l'adresse de la carte ; "
"plusieurs valeurs se séparent par des virgules."
msgstr ""
"Elke parameter kun je met de hand in het adres van de kaart zetten; "
"meerdere waarden scheid je met komma's."

#: scripts/_lib/map_template.py:613
msgid "Cépage : identifiant, nom ou synonyme VIVC."
msgstr "Druif: sleutel, naam of VIVC-synoniem."

#: scripts/_lib/map_template.py:614
msgid "Cépage principal uniquement."
msgstr "Alleen hoofddruif."

#: scripts/_lib/map_template.py:615
msgid "Style de vin : identifiant ou libellé."
msgstr "Wijnstijl: sleutel of label."

#: scripts/_lib/map_template.py:616
msgid "Pays entier coché."
msgstr "Heel land aangevinkt."

#: scripts/_lib/map_template.py:617
msgid "Région (code pays:clé)."
