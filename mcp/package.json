{
  "name": "owm-mcp",
  "private": true,
  "type": "module",
  "description": "Remote MCP server for Open Wine Map (Bunny Edge Script). See docs/plan-mcp-server.md.",
  "scripts": {
    "build": "esbuild src/edge.js --bundle --format=esm --platform=browser --target=es2022 --external:node:* --minify --legal-comments=none --metafile=dist/meta.json --outfile=dist/edge.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@bunny.net/edgescript-sdk": "0.13.0",
    "@cfworker/json-schema": "4.1.1",
    "@modelcontextprotocol/server": "2.3.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "esbuild": "0.28.2"
  }
}
